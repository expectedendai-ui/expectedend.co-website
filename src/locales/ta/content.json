  "services": {
    "01": {
      "title": "ஆப்கள்",
      "body": "உண்மையான மனிதர்களை மனதில் கொண்டு வடிவமைத்த, பயனுள்ள, சிந்தனைமிக்க தயாரிப்புகள்.",
      "interest": "ஆப் அல்லது மென்பொருள் யோசனையை உருவாக்குதல்"
    },
    "02": {
      "title": "இணையதளங்கள்",
      "body": "தெளிவும் உயிர்ப்பும் வரவேற்பும் நிறைந்த, தனித்துவமான டிஜிட்டல் இல்லங்கள்.",
      "interest": "இணையதளம் அல்லது டிஜிட்டல் அனுபவம்"
    },
    "03": {
      "title": "AI அமைப்புகள்",
      "body": "யோசனைகளையும் அணிகளையும் முன்னோக்கி நகர்த்த உதவும் நடைமுறை நுண்ணறிவு.",
      "interest": "AI அமைப்பு அல்லது செயல்திறன் கருவி"
    },
    "04": {
      "title": "படைப்பாக்கம்",
      "body": "அர்த்தத்தை மையமாகக் கொண்ட அடையாளம், திசை, அனுபவங்கள்.",
      "interest": "படைப்பாக்க வழிகாட்டல் அல்லது வடிவமைப்பு"
    },
    "05": {
      "title": "HeadQuarters",
      "body": "உங்கள் வணிகத்துக்கான பிரத்யேக இல்லம். CRM, நிதி, திட்டங்கள், அணிக் கருவிகள், அடுத்து உங்களுக்குத் தேவைப்படும் எந்தத் திறனும், எல்லாம் ஒரே இடத்தில்.",
      "interest": "HeadQuarters"
    },
    "06": {
      "title": "ஆட்டோமேஷன்",
      "body": "திரும்பத் திரும்பச் செய்யும் வேலைகளுக்குப் பதிலாக, உங்கள் வணிகத்தை இயங்க வைக்கும் இணைக்கப்பட்ட பணிப்பாய்வுகள்.",
      "interest": "ஆட்டோமேஷன்"
    },
    "07": {
      "title": "வாடிக்கையாளர் போர்ட்டல்கள்",
      "body": "வாடிக்கையாளர்களுக்கோ உறுப்பினர்களுக்கோ தொடர்புகொள்ள, முன்பதிவு செய்ய, கோப்புகளைப் பகிர, முன்னேற்றத்தைக் கண்காணிக்க ஒரே நேர்த்தியான இடம்.",
      "interest": "வாடிக்கையாளர் போர்ட்டல்கள்"
