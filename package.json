{
  "name": "expectedend-co",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "check:public-content": "RELEASE_CHECK=1 vitest run src/company-site/public-content.test.ts",
    "check:types": "tsc --noEmit -p tsconfig.app.json",
    "check:biome": "biome lint --diagnostic-level=error --no-errors-on-unmatched --files-ignore-unknown=true",
    "check": "npm run check:types && npm run check:biome",
    "lint": "npm run check:biome",
    "format": "biome check --write --unsafe",
    "preview": "vite preview",
    "deploy": "npm run check:public-content && npm run build && npx wrangler@4.120.0 pages deploy dist --project-name=expectedend-co --branch=main"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.4.2",
    "@tailwindcss/vite": "4.3.0",
    "lucide-react": "1.37.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "4.3.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.7",
    "vitest": "^3.0.0"
  }
}
